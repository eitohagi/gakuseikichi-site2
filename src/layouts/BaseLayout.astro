---
// すべてのページの外枠
import "@fontsource-variable/anybody/standard.css";
import "@fontsource/zen-old-mincho/400.css";
import "@fontsource/zen-old-mincho/700.css";
import "@fontsource/zen-old-mincho/900.css";
import "../styles/global.css";
import Seo from "../components/layout/Seo.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import Cursor from "../components/layout/Cursor.astro";
import { getSettings } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: string;
  /** トップページだけ "hero"（ヒーローを過ぎてから帯に背景をつける） */
  headerSolidFrom?: "top" | "hero";
}
const { headerSolidFrom = "top", ...seo } = Astro.props;
const settings = await getSettings();
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e9ece6" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Seo settings={settings} {...seo} />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <SiteHeader name={settings.name} solidFrom={headerSolidFrom} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter settings={settings} />
    <Cursor />
  </body>
</html>
