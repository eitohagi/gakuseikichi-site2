---
// 画像の枠。写真が登録されていれば写真を、なければ作った人の色で和柄を描く
import type { Img } from "../../lib/content";
import { paletteOf } from "../../lib/palette";
import { cmsImg, srcset } from "../../lib/format";
interface Props {
  image: Img | null;
  color: string;
  seed: number;
  /** 高さ ÷ 幅（例：4/5 → 1.25） */
  ratio: number;
  sizes: string;
  alt?: string;
  eager?: boolean;
  class?: string;
}
const { image, color, seed, ratio, sizes, alt = "", eager = false, class: cls } = Astro.props;
const widths = [360, 540, 720, 1080, 1440];
---
<div class:list={["tile", cls]} style={`aspect-ratio:1/${ratio}`}>
  {image ? (
    <img
      src={cmsImg(image.url, 720, { h: 720 * ratio, fit: "crop" })}
      srcset={srcset(image.url, widths, ratio)}
      sizes={sizes}
      width={720}
      height={Math.round(720 * ratio)}
      alt={alt || image.alt || ""}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : undefined}
    />
  ) : (
    <canvas data-art="pattern" data-pal={JSON.stringify(paletteOf(color))} data-kind={seed % 4} data-seed={seed + 1} aria-hidden="true"></canvas>
  )}
</div>

<script>
  import { paintAll } from "../../scripts/art";
  paintAll();
</script>

<style>
  .tile { position: relative; width: 100%; max-width: 100%; overflow: hidden; background: var(--paper); }
  .tile img, .tile canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
