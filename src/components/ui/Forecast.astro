---
// 未来予報：ひとことの予報、年ごとの確率、今日できる行動
import type { Forecast } from "../../lib/content";
import { pctWord } from "../../lib/format";
interface Props { forecast: Forecast; label?: string; note?: string }
const { forecast: f, label, note } = Astro.props;
---
<div class="fc">
  {label && <p class="lbl">{label}</p>}
  {f.claim && <p class="claim">{f.claim}</p>}
  {f.steps.length > 0 && (
    <ol class="steps" aria-label="年ごとの実現確率">
      {f.steps.map((s) => (
        <li>
          <span class="y">{s.year}年</span>
          <span class="p">{s.prob}<small>%</small></span>
          <span class="w">{pctWord(s.prob)}</span>
          <span class="bar" aria-hidden="true"><i style={`width:${s.prob}%`}></i></span>
        </li>
      ))}
    </ol>
  )}
  {f.action && <p class="act"><b>今日</b><span>{f.action}</span></p>}
  {note && <p class="lbl note">{note}</p>}
</div>

<style>
  .fc { padding-top: 18px; border-top: 1px solid var(--ai); }
  .lbl { font-size: 13px; color: var(--ai-2); margin-bottom: 8px; }
  .note { margin: 14px 0 0; }
  .claim { font-size: 20px; font-weight: 700; line-height: 1.55; }
  .steps { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(72px, 1fr)); gap: 14px; }
  .steps li { display: grid; }
  .y { font-family: var(--f-display); font-size: 13px; color: var(--ai-2); font-variation-settings: "wdth" 80; }
  .p { font-family: var(--f-display); font-size: 46px; line-height: 1; font-weight: 300; font-variation-settings: "wdth" 62; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .p small { font-size: 16px; font-weight: 500; margin-left: 2px; }
  .w { font-size: 12px; color: var(--ai-2); margin-top: 2px; }
  .bar { height: 2px; background: var(--rule); margin-top: 8px; display: block; }
  .bar i { display: block; height: 100%; background: var(--ai); }
  .act { margin-top: 18px; font-size: 14.5px; line-height: 1.75; display: flex; gap: 10px; align-items: flex-start; }
  .act b { flex: none; background: var(--kihada); font-size: 12px; padding: 1px 7px; margin-top: 3px; font-weight: 700; }
</style>
