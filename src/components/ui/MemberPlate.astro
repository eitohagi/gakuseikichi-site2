---
import type { Member } from "../../lib/content";
import Portrait from "./Portrait.astro";
import Forecast from "./Forecast.astro";
interface Props { member: Member; seed: number; articleCount?: number; headingLevel?: 2 | 3 }
const { member: m, seed, articleCount = 0, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? "h2" : "h3";
---
<article class="plate" id={`m-${m.id}`}>
  <a class="pic" href={`/members/${m.id}/`} tabindex="-1" aria-hidden="true"><Portrait member={m} seed={seed} /></a>
  <div class="head">
    <H class="name"><a href={`/members/${m.id}/`}>{m.name}</a></H>
    {m.role !== "メンバー" && <span class="role">{m.role}</span>}
  </div>
  {m.field && <p class="field">{m.field}</p>}
  {m.project ? <p class="proj">{m.project}</p> : <p class="proj pending">プロジェクトは準備中です</p>}
  {m.description && <p class="desc">{m.description}</p>}
  {m.forecast && <div class="fcw"><Forecast forecast={m.forecast} /></div>}
  {articleCount > 0 && <a class="link" href={`/members/${m.id}/`}>記事を読む（{articleCount}本）</a>}
</article>

<style>
  .plate { scroll-margin-top: 90px; }
  .pic { display: block; }
  .pic:hover :global(canvas) { outline: 3px solid var(--kihada); outline-offset: 4px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 18px; }
  .name { font-size: 22px; font-weight: 700; }
  .name a { text-decoration: none; }
  .name a:hover { text-decoration: underline; text-decoration-color: var(--kihada); text-decoration-thickness: 4px; text-underline-offset: 5px; }
  .role { flex: none; font-size: 12px; font-weight: 700; background: var(--kihada); padding: 1px 8px; }
  .pending { color: var(--ai-2); }
  .field { margin-top: 2px; font-family: var(--f-display); font-size: 13px; font-variation-settings: "wdth" 80; color: var(--ai-2); white-space: nowrap; }
  .proj { font-size: 15px; margin-top: 2px; }
  .desc { font-size: 14px; color: var(--ai-2); margin-top: 6px; line-height: 1.75; }
  .fcw { margin-top: 22px; }
  .link { display: inline-block; margin-top: 14px; font-size: 14px; text-decoration: none; border-bottom: 1px solid var(--ai); }
  .link:hover { background: var(--kihada); }
</style>
