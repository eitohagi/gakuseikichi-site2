---
// メンバーのモザイク肖像。写真があれば写真の色で、なければメンバーの色で描く
import type { Member } from "../../lib/content";
import { paletteOf } from "../../lib/palette";
import { cmsImg } from "../../lib/format";
interface Props { member: Member; seed: number; class?: string }
const { member: m, seed, class: cls } = Astro.props;
const photo = m.photo ? cmsImg(m.photo.url, 160, { h: 180, fit: "crop", faces: true }) : undefined;
---
<canvas
  class:list={["portrait", cls]}
  data-art="mosaic"
  data-pal={JSON.stringify(paletteOf(m.color))}
  data-seed={seed}
  data-photo={photo}
  role="img"
  aria-label={`${m.name}のモザイク肖像`}
></canvas>

<script>
  import { paintAll } from "../../scripts/art";
  paintAll();
</script>

<style>
  .portrait { display: block; width: 100%; aspect-ratio: 13 / 15; background: var(--paper); }
</style>
