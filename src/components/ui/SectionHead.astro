---
// 各ページ・各セクションの見出し。左に脳の部位を縦書きで置く
import { navOf, type NavKey } from "../../config/site";
interface Props { nav: NavKey; title?: string; level?: 1 | 2; tone?: "light" | "dark" }
const { nav, title, level = 2, tone = "light" } = Astro.props;
const n = navOf(nav);
const Tag = level === 1 ? "h1" : "h2";
---
<header class:list={["sh", tone]}>
  <div class="lobe" aria-hidden="true"><span class="k">{n.lobe}</span><span class="r">{n.role}</span></div>
  <div class="main">
    <Tag set:html={(title ?? n.label).replace(/\n/g, "<br>")} />
    {Astro.slots.has("default") && <div class="desc"><slot /></div>}
  </div>
  {Astro.slots.has("aside") && <div class="aside"><slot name="aside" /></div>}
</header>

<style>
  .sh { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 7fr) minmax(0, 3fr); gap: 24px; align-items: start; margin-bottom: clamp(36px, 5vw, 64px); }
  @media (max-width: 900px) { .sh { grid-template-columns: auto minmax(0, 1fr); } .aside { grid-column: 2; } }
  .lobe { display: flex; gap: 10px; align-items: flex-start; }
  .k { writing-mode: vertical-rl; inline-size: max-content; font-size: clamp(40px, 4.6vw, 68px); font-weight: 900; line-height: 1; letter-spacing: 0.08em; }
  .r { writing-mode: vertical-rl; inline-size: max-content; font-size: 13px; color: var(--ai-2); letter-spacing: 0.2em; padding-top: 4px; border-right: 1px solid var(--rule); padding-right: 6px; }
  h1, h2 { font-size: clamp(34px, 5.2vw, 76px); line-height: 1.15; letter-spacing: 0.01em; font-weight: 700; }
  .desc { margin-top: 18px; font-size: 15px; color: var(--ai-2); max-width: 34em; }
  .desc :global(p + p) { margin-top: 0.8em; }
  .aside { font-size: 13px; color: var(--ai-2); padding-top: 14px; border-top: 1px solid var(--ai); align-self: end; }
  .dark .k { color: var(--kihada); }
  .dark .r { color: var(--on-ai-2); border-color: var(--on-ai-rule); }
  .dark .desc, .dark .aside { color: var(--on-ai-2); }
  .dark .aside { border-color: var(--on-ai); }
</style>
