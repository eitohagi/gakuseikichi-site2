---
// マウスで操作しているときだけ出る、黄蘗の小さな点
---
<div class="cur" id="cur" aria-hidden="true"></div>

<style>
  .cur {
    position: fixed; left: 0; top: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%;
    background: var(--kihada); box-shadow: 0 0 0 1.5px var(--ai); pointer-events: none; z-index: 100;
    transition: width 0.25s, height 0.25s, margin 0.25s, background 0.25s; display: none;
  }
  .cur:global(.big) { width: 44px; height: 44px; margin: -22px 0 0 -22px; background: rgba(242, 194, 27, 0.35); }
  @media (pointer: fine) { :global(.has-cur) .cur { display: block; } }
</style>

<script>
  const cur = document.getElementById("cur")!;
  const fine = matchMedia("(pointer: fine)").matches;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (fine && !reduce) {
    document.documentElement.classList.add("has-cur");
    let mx = -100, my = -100, x = -100, y = -100;
    addEventListener("pointermove", (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
    document.addEventListener("pointerover", (e) => {
      const t = e.target as Element;
      if (t.closest("[data-cursor-self]")) return; // 自分で大きさを決める要素（脳の図）
      cur.classList.toggle("big", !!t.closest("a,button,input,select,textarea,label,summary"));
    });
    const loop = () => { x += (mx - x) * 0.22; y += (my - y) * 0.22; cur.style.transform = `translate(${x}px,${y}px)`; requestAnimationFrame(loop); };
    loop();
  }
</script>
