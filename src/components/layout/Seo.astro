---
// <head> の中身：タイトル、説明、SNS用の情報、構造化データ
import type { SiteSettings } from "../../config/site";

interface Props {
  settings: SiteSettings;
  title?: string;
  description?: string;
  image?: string | null;
  type?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: string;
}
const { settings, title, description, image, type = "website", noindex = false, jsonLd, publishedAt } = Astro.props;
const fullTitle = title ? `${title}｜${settings.name}` : `${settings.name}｜${settings.mission}`;
const desc = description || settings.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || settings.ogImage || "/og.png", Astro.site).href;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: settings.name,
  alternateName: settings.nameEn,
  url: Astro.site?.href,
  description: settings.description,
  logo: new URL("/icon-512.png", Astro.site).href,
  sameAs: [
    settings.instagram && `https://www.instagram.com/${settings.instagram}/`,
    settings.youtube,
    settings.x && `https://x.com/${settings.x}`,
  ].filter(Boolean),
};
const ld = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:site_name" content={settings.name} />
<meta property="og:title" content={title ?? settings.name} />
<meta property="og:description" content={desc} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="ja_JP" />
<meta name="twitter:card" content="summary_large_image" />
{settings.x && <meta name="twitter:site" content={`@${settings.x}`} />}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
<link rel="alternate" type="application/rss+xml" title={`${settings.name}の記事`} href="/rss.xml" />
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, "\\u003c")} />
