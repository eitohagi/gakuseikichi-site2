---
import BaseLayout from "../layouts/BaseLayout.astro";
import { NAV } from "../config/site";
---
<BaseLayout title="ページが見つかりません" noindex>
  <div class="in page-top nf">
    <p class="code num">404</p>
    <h1>このページは見つかりませんでした。</h1>
    <p class="desc">記事が非公開になったか、URLが変わった可能性があります。下の一覧から探してください。</p>
    <ul>
      <li><a href="/">トップ</a></li>
      {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
  </div>
</BaseLayout>

<style>
  .code { font-size: clamp(120px, 24vw, 320px); font-weight: 800; line-height: 0.8; font-variation-settings: "wdth" 150, "wght" 800; letter-spacing: -0.04em; }
  h1 { font-size: clamp(24px, 3vw, 36px); margin-top: 24px; }
  .desc { color: var(--ai-2); margin-top: 8px; }
  ul { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  a { text-decoration-color: var(--kihada); text-decoration-thickness: 3px; text-underline-offset: 5px; }
</style>
